# Server port
PORT=3001

# Database (local or remote)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password
DB_NAME=drogueria_app

# Optional single URL (for Supabase or remote DB)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# SSL flag for remote DBs
DB_SSL=false

# Optional schema for a second pharmacy in the same database (default: public)
# DB_SCHEMA=puerto_millo

# Supabase mirror (use the Session Pooler connection string, port 5432)
# SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SUPABASE_DB_SSL=true

# Safety switch: only set to true on the PRODUCTION machine.
# On a development machine leave it false/absent so the data sync cannot
# overwrite the production Supabase mirror.
SUPABASE_SYNC_ENABLED=false